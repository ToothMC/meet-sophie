{
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/((?!api|_next|favicon|apple-touch|sophie|site).*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ],
  "redirects": [
    {
      "source": "/pricing/",
      "destination": "/pricing",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/ai/health",
      "schedule": "* * * * *"
    }
  ],
  "ignoreCommand": "git log -1 --pretty=%B | grep -qE '^auto: save'"
}
