{
  "outputDirectory": ".",
  "functions": {
    "api/chat.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/(.*\\.(?:webp|avif|jpg|jpeg|png|svg|ico|gif|woff2|woff|ttf|eot)$)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*\\.(?:js|css|mp4|webm|mov)$)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ],
  "redirects": [
    {
      "source": "/pricing/",
      "destination": "/pricing",
      "permanent": true
    },
    { "source": "/api/(.*\\.(?:js|mjs|ts|json))", "destination": "/404", "permanent": false },
    { "source": "/lib/((?!sophie-auth-helper\\.js$|sophie-emotion\\.js$|sophie-export\\.js$|sophie-face-visualizer\\.js$|sophie-report-overlay\\.js$|sophie-tab-manager\\.js$|sophie-transcript-cache\\.js$).*)", "destination": "/404", "permanent": false },
    { "source": "/:dir(scripts|tests|supabase|docs|src|\\.claude|\\.github)/:path*", "destination": "/404", "permanent": false },
    { "source": "/:file(README\\.md|vercel\\.json|package\\.json|package-lock\\.json|\\.gitignore)", "destination": "/404", "permanent": false }
  ],
  "crons": [
    {
      "path": "/api/ai/health",
      "schedule": "*/5 * * * *"
    }
  ],
  "ignoreCommand": "git log -1 --pretty=%B | grep -qE '^auto: save'"
}
