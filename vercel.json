{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(.*).(?:png|jpg|ico|svg|webp|woff2)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    {
      "source": "/pricing/",
      "destination": "/pricing",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/ai/health",
      "schedule": "* * * * *"
    }
  ],
  "ignoreCommand": "git log -1 --pretty=%B | grep -qE '^auto: save'"
}
